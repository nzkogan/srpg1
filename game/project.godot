; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SRPG1"
run/main_scene="res://scenes/overworld.tscn"

[autoload]

Canon="*res://scripts/canon.gd"
GameState="*res://scripts/game_state.gd"
Supports="*res://scripts/supports.gd"
Equipment="*res://scripts/equipment.gd"
Progression="*res://scripts/progression.gd"
Forge="*res://scripts/forge.gd"
Defections="*res://scripts/defections.gd"
Deputy="*res://scripts/deputy.gd"
Epilogue="*res://scripts/epilogue.gd"
Provenance="*res://scripts/provenance.gd"
Mounts="*res://scripts/mounts.gd"
Huma="*res://scripts/huma.gd"
Almanac="*res://scripts/almanac.gd"
SaveGame="*res://scripts/save_game.gd"
